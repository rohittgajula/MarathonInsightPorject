# Copy to .env and adjust. .env is gitignored.
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1

POSTGRES_DB=runproject
POSTGRES_USER=runproject
POSTGRES_PASSWORD=runproject

# Host ports (container ports are fixed). Defaults avoid clashing with a local pg/redis.
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=5173

VITE_API_BASE=http://localhost:8000/api

# Host directory holding Garmin OAuth tokens, written by `garmin-mcp login`.
# Mounted read-only into the backend; only the refreshable token, never a password.
GARMIN_TOKEN_DIR=/Users/rohitgajula/Library/Caches/garmin-mcp/garth

# Reads your daily log — turns free text into pain, food, sleep and hydration
# signals, and works out whether an entry is about today or tomorrow.
# Optional: with neither key set the app falls back to keyword matching and
# says so in the UI rather than failing.
#
# Gemini has a free tier and needs no card: https://aistudio.google.com
# Note the free tier's data terms before logging health details to it.
GEMINI_API_KEY=
# Claude reads casual, code-switched text more reliably, but is paid
# (separate from a Claude.ai subscription): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Force one backend. Unset, whichever key is present is used (Gemini first).
LOG_AI_PROVIDER=
